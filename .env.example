SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only — set on the Supabase Edge Function, NOT in the app:
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Android release / Play deployment
# ---------------------------------------------------------------------------
# These are NOT app runtime config. They are the names of the values used to
# sign and ship release builds. In CI they live as GitHub Actions repository
# secrets (Settings → Secrets and variables → Actions). For a local release
# build you may export them in your shell — never commit real values, the
# keystore file, or the service-account JSON. See docs/deployment.md.

# Upload keystore, base64-encoded (CI decodes it to a file at build time).
# Generate: base64 -i upload-keystore.jks | tr -d '\n'
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Google Cloud service-account JSON key (full file contents) with permission to
# release to the internal testing track only — NOT production.
PLAY_SERVICE_ACCOUNT_JSON=

# --- Gradle-facing env vars (set by CI from the secrets above; for local builds) ---
# SPENDLY_UPLOAD_STORE_FILE — absolute path to the decoded keystore file
# SPENDLY_UPLOAD_STORE_PASSWORD — = ANDROID_KEYSTORE_PASSWORD
# SPENDLY_UPLOAD_KEY_ALIAS — = ANDROID_KEY_ALIAS
# SPENDLY_UPLOAD_KEY_PASSWORD — = ANDROID_KEY_PASSWORD
# SPENDLY_VERSION_CODE — integer, must exceed any code already on any track
# SPENDLY_VERSION_NAME — human-facing version string (optional; defaults to 1.0)
